	dw	rotz80
	dw	srz80
	dw	srzx
	dw	st8ix1
	dw	st8ix2
	dw	st8ix3
	dw	stabd
	dw	0

tstr:	macro	insn,memop,iy,ix,hl,de,bc,flags,acc,sp
	local	lab
&lab:	db	insn
	ds	&lab+4-$,0
	dw	&memop,&iy,&ix,&hl,&de,&bc
	db	&flags
	db	&acc
	dw	&sp
	if	$-&lab ne 20
	error	'missing parameter'
	endif
	endm

tmsg:	macro	m
	local	lab
&lab:	db	m
	if	$ ge &lab+30
	error	'message too long'
	else
	ds	&lab+30-$,'.'
	endif
	db	'$'
	endm

; <adc,sbc> hl,<bc,de,hl,sp> (38,912 cycles)
adc16:	db	0ffh		; flag mask
	tstr	<0edh,042h>,0832ch,04f88h,0f22bh,0b339h,07e1fh,01563h,0d3h,089h,0465eh
	local	lab
	     ^ ***ERROR*** unknown instruction
&lab:	db	0edh,042h
 ^ ***ERROR*** instruction expected
	ds	&lab+4-$,0
	  	 ^ ***ERROR*** syntax error
	dw	0832ch,04f88h,0f22bh,0b339h,07e1fh,01563h
	db	0d3h
	db	089h
	dw	0465eh
	if	$-&lab ne 20
	  	   ^ ***ERROR*** syntax error
	error	'missing parameter'
	     ^ ***ERROR*** unknown instruction
	endif
	     ^ ***ERROR*** no #if pending
	tstr	<0,038h>,0,0,0,0f821h,0,0,0,0,0		; (1024 cycles)
	local	lab
	     ^ ***ERROR*** unknown instruction
&lab:	db	0,038h
 ^ ***ERROR*** instruction expected
	ds	&lab+4-$,0
	  	 ^ ***ERROR*** syntax error
	dw	0,0,0,0f821h,0,0
	db	0
	db	0
	dw	0
	if	$-&lab ne 20
	  	   ^ ***ERROR*** syntax error
	error	'missing parameter'
	     ^ ***ERROR*** unknown instruction
	endif
	     ^ ***ERROR*** no #if pending
	tstr	0,0,0,0,-1,-1,-1,0d7h,0,-1		; (38 cycles)
	local	lab
	     ^ ***ERROR*** unknown instruction
&lab:	db	0
 ^ ***ERROR*** instruction expected
	ds	&lab+4-$,0
	  	 ^ ***ERROR*** syntax error
	dw	0,0,0,-1,-1,-1
	db	0d7h
	db	0
	dw	-1
	if	$-&lab ne 20
	  	   ^ ***ERROR*** syntax error
	error	'missing parameter'
	     ^ ***ERROR*** unknown instruction
	endif
	     ^ ***ERROR*** no #if pending
	db	0d4h,08ah,0d5h,019h			; expected crc
	tmsg	'<adc,sbc> hl,<bc,de,hl,sp>'
	local	lab
	     ^ ***ERROR*** unknown instruction
&lab:	db	'<adc,sbc> hl,<bc,de,hl,sp>'
 ^ ***ERROR*** instruction expected
	if	$ ge &lab+30
	  	      ^ ***ERROR*** syntax error
	error	'message too long'
	     ^ ***ERROR*** unknown instruction
	else
	    ^ ***ERROR*** #else without #if
	ds	&lab+30-$,'.'
	  	 ^ ***ERROR*** syntax error
	endif
	     ^ ***ERROR*** no #if pending
	db	'$'

; add hl,<bc,de,hl,sp> (19,456 cycles)
add16:	db	0ffh		; flag mask
	tstr	9,0c4a5h,0c4c7h,0d226h,0a050h,058eah,08566h,0c6h,0deh,09bc9h
	local	lab
